generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Níveis da equipe: STAFF (Atendente) < MANAGER (Gerente) < OWNER (Proprietário).
// O que cada nível pode fazer fica em `src/lib/permissions.ts`.
enum Role {
  CUSTOMER
  STAFF
  MANAGER
  OWNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// Alérgenos e ingredientes sensíveis que a loja informa por produto ("Contém: …").
/// Rótulos em `src/lib/allergens.ts`.
enum Allergen {
  GLUTEN
  LACTOSE
  EGGS
  PEANUTS
  TREE_NUTS
  SOY
  COCONUT
  ARTIFICIAL_COLORS
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  PIX_MANUAL
  CARD_ON_DELIVERY
  PIX_ONLINE
  CARD_ONLINE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  phone               String
  passwordHash        String
  /// Foto de perfil no Cloudinary (pasta mistydoces/avatars); sem foto, mostra a inicial.
  avatarUrl           String?
  role                Role                @default(CUSTOMER)
  addresses           Address[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  reviews             Review[]
  favorites     Favorite[]
  expenses      Expense[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

/// Token de redefinição de senha ("esqueci minha senha"). Armazenamos o hash
/// do token, nunca o valor enviado por e-mail — se o banco vazar, os links
/// de reset já emitidos continuam inúteis para um atacante.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  reference    String?
  isDefault    Boolean  @default(false)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  imageUrl    String?
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  isAvailable Boolean          @default(true)
  isActive    Boolean          @default(true)
  /// Antecedência mínima em dias: 0 = pronta-entrega; 2 = encomenda com 2 dias.
  leadTimeDays Int             @default(0)
  /// Lista de ingredientes em texto livre. Preenchida = a loja revisou os alérgenos
  /// (só esses produtos entram nos filtros "Sem glúten" etc.).
  ingredients      String?
  allergens        Allergen[]  @default([])
  mayContainTraces Boolean     @default(false)
  /// Personalização grátis por item (ex.: nome no bolo). `notePrompt` é a pergunta do campo.
  allowsNote  Boolean          @default(false)
  notePrompt  String?
  /// Fotos extras da galeria. A capa continua sendo `imageUrl`.
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  favoritedBy Favorite[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
}

/// Produto salvo por um cliente logado. Visitantes guardam favoritos num cookie
/// (`lib/favorites.ts`), que é juntado aqui quando a pessoa entra na conta.
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

/// Só quem tem um pedido DELIVERED com esse produto pode avaliar (checado no
/// backend, nunca confiando no client) — uma avaliação por cliente/produto.
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

/// Um produto sempre tem >=1 variante (ex.: "Único", "Caixa com 6") — o
/// preço mora aqui, nunca em Product, mesmo para itens sem opção de formato.
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  price      Decimal     @db.Decimal(10, 2)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, label])
  @@index([productId])
}

model Order {
  id           String       @id @default(cuid())
  orderNumber  Int          @unique @default(autoincrement())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  status       OrderStatus  @default(PENDING)
  deliveryType DeliveryType

  addressId            String?
  address              Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  deliveryLabel        String?
  deliveryZipCode      String?
  deliveryStreet       String?
  deliveryNumber       String?
  deliveryComplement   String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryState        String?
  deliveryReference    String?

  items   OrderItem[]
  payment Payment?

  couponId           String?
  coupon             Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCodeSnapshot String?
  discountAmount     Decimal @default(0) @db.Decimal(10, 2)

  /// Início da janela (1h) de entrega/retirada. Só pedidos anteriores ao agendamento ficam sem.
  scheduledFor DateTime?

  notes       String?
  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

/// Desconto sempre incide sobre o subtotal dos itens, nunca sobre a taxa de
/// entrega. `usedCount` é incrementado atomicamente na criação do pedido
/// (não na validação/prévia), para não gastar um uso só de exibir o desconto.
model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minOrderValue Decimal?   @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int        @default(0)
  isActive      Boolean    @default(true)
  expiresAt     DateTime?
  orders        Order[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model OrderItem {
  id                   String         @id @default(cuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId            String
  variant              ProductVariant @relation(fields: [variantId], references: [id])
  productNameSnapshot  String
  variantLabelSnapshot String
  unitPriceSnapshot    Decimal        @db.Decimal(10, 2)
  quantity             Int
  subtotal             Decimal        @db.Decimal(10, 2)
  /// Personalização escrita pelo cliente (ex.: "Parabéns, Ana!"), quando o produto permite.
  note                 String?

  @@index([orderId])
  @@index([variantId])
}

/// Pagamentos online (Mercado Pago) preenchem `provider`/`externalId`/`externalStatus`;
/// pagamentos offline (dinheiro, Pix manual, cartão na entrega) deixam esses campos nulos.
/// `externalId` é único e é a chave de idempotência do webhook — a mesma notificação
/// pode chegar mais de uma vez, e nunca deve aplicar o efeito (avançar o pedido) duas vezes.
model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  provider        String?
  externalId      String?       @unique
  externalStatus  String?
  pixQrCode       String?
  pixQrCodeBase64 String?
  pixExpiresAt    DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model StoreSettings {
  id           String   @id @default("singleton")
  storeName    String
  description  String?
  phone        String?
  email        String?
  whatsapp     String?
  instagram    String?
  street       String?
  city         String?
  state        String?
  zipCode      String?
  /// Observação livre sobre o horário (ex.: "Feriados sob consulta"). Era o antigo
  /// `openingHours` em texto livre — renomeado na migration, sem perder o conteúdo.
  hoursNote    String?
  /// Horário por dia da semana: [{ day: 0-6 (0 = domingo), open: "13:00", close: "21:00" }].
  /// Dia ausente = fechado; `null` = nunca configurado (vale o padrão de `lib/store-hours`).
  weeklyHours  Json?
  /// Tempo mínimo (min) entre fazer o pedido e a primeira janela de entrega/retirada.
  prepMinutes    Int  @default(60)
  /// Até quantos dias à frente o cliente pode agendar.
  maxAdvanceDays Int  @default(30)
  /// Feriados e folgas, como "YYYY-MM-DD" no fuso da loja.
  blockedDates   Json @default("[]")
  deliveryFee  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ExpenseCategory {
  MATERIAL
  EMBALAGEM
  ENTREGA
  EQUIPAMENTO
  MARKETING
  OUTROS
}

/// Despesa da loja (painel financeiro). O mês vem da data, no fuso da loja.
model Expense {
  id          String          @id @default(cuid())
  title       String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  /// "YYYY-MM-DD" no fuso da loja (mesmo formato de `blockedDates`).
  date        String
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
}

/// Aviso "o faturamento cobriu as despesas", um por mês. Guarda o total de despesas
/// avisado: só avisa de novo se as despesas do mês crescerem e forem cobertas outra vez.
model BreakEvenNotice {
  /// "YYYY-MM" no fuso da loja.
  month         String   @id
  expensesTotal Decimal  @db.Decimal(10, 2)
  sentAt        DateTime @default(now())
}
